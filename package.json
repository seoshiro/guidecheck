{
  "name": "guidecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:browser": "tsc --noEmit && vite build --mode browser",
    "preview:browser": "vite preview --mode browser --host 127.0.0.1 --port 4394 --strictPort",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/core.test.ts tests/api.test.ts tests/workspace.test.ts",
    "test:browser:public": "playwright test --config playwright.browser.config.ts",
    "test:browser": "playwright test",
    "test:production": "node scripts/verify-production.mjs",
    "format": "prettier --write src server tests scripts *.ts *.js *.json *.html",
    "format:check": "prettier --check src server tests scripts *.ts *.js *.json *.html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0"
  }
}
